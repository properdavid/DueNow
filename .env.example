# Copy to .env and fill in. Not auto-loaded:
#   set -a; . ./.env; set +a; npm run dev

# SQLite file location
DUENOW_DATABASE_PATH=data/duenow.sqlite

# Comma-separated allowlist of household emails (required)
DUENOW_ALLOWED_EMAILS=you@example.com,partner@example.com

# Google OAuth (required in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Dev sign-in identity (non-production only)
DUENOW_DEV_AUTH_EMAIL=you@example.com
DUENOW_DEV_AUTH_NAME=Your Name

# Version baked into the build; defaults to the git commit
# DUENOW_APP_VERSION=

# Production server port
# PORT=3000
